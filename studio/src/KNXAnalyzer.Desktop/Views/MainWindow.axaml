<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KNXAnalyzer.Desktop.ViewModels" xmlns:views="using:KNXAnalyzer.Desktop.Views" x:Class="KNXAnalyzer.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel" Title="KNX TP1 Analyzer Studio" Width="1400" Height="850" MinWidth="950" MinHeight="600">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="12" RowSpacing="8">
    <DockPanel Grid.Row="0" LastChildFill="True">
      <Button DockPanel.Dock="Right" Content="Open SD / Sessions Folder" Click="OpenClicked" Margin="8,0,0,0" />
      <Button DockPanel.Dock="Right" Content="Network" Click="NetworkClicked" Margin="8,0,0,0" />
      <Button DockPanel.Dock="Right" Content="Import selected" Click="ImportNetworkSessionClicked" Margin="8,0,0,0" />
      <ComboBox DockPanel.Dock="Right" Width="360" ItemsSource="{Binding NetworkSessions}" SelectedItem="{Binding SelectedNetworkSession}">
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <TextBox DockPanel.Dock="Right" Width="220" Text="{Binding NetworkHost}" PlaceholderText="Analyzer hostname / IP" />
      <Button DockPanel.Dock="Right" Content="Générer lot complet" Click="BatchClicked" Margin="8,0,0,0" />
      <Button DockPanel.Dock="Right" Content="Export JSON" Click="ExportJsonClicked" Margin="8,0,0,0" />
      <Button DockPanel.Dock="Right" Content="Générer rapport" Click="ReportClicked" Margin="8,0,0,0" />
      <ComboBox x:Name="AnalysisScope" DockPanel.Dock="Right" SelectedIndex="0" MinWidth="170" Margin="8,0,0,0">
        <ComboBoxItem Content="Session sélectionnée"/><ComboBoxItem Content="Dossier complet"/>
      </ComboBox>
      <TextBox Text="{Binding FolderPath}" PlaceholderText="SD root or sessions folder" KeyDown="PathKeyDown" />
    </DockPanel>
    <StackPanel Grid.Row="1"><TextBlock Text="{Binding NetworkAnalyzer}" TextWrapping="Wrap"/><TextBlock Text="{Binding NetworkProgress}" Opacity="0.7"/></StackPanel>
    <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" />
    <Grid Grid.Row="3" ColumnDefinitions="270,6,*">
      <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="6">
        <TextBlock Text="Sessions" FontWeight="Bold" />
        <ListBox Grid.Row="1" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}">
          <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3"><TextBlock Text="{Binding Id}" FontWeight="SemiBold"/><TextBlock Text="{Binding State}"/><TextBlock Text="{Binding Generation}" Opacity="0.7" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns" />
      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*" RowSpacing="6">
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" />
        <ComboBox Grid.Row="1" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" HorizontalAlignment="Left" MinWidth="150" />
        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}">
          <TabItem Header="Télégrammes TP1">
            <Grid RowDefinitions="Auto,*,6,170">
              <Grid ColumnDefinitions="135,155,105,120,105,55,80,55,*" Margin="7"><TextBlock Text="Time"/><TextBlock Grid.Column="1" Text="Classification"/><TextBlock Grid.Column="2" Text="Source"/><TextBlock Grid.Column="3" Text="Destination"/><TextBlock Grid.Column="4" Text="Type / Service"/><TextBlock Grid.Column="5" Text="Length"/><TextBlock Grid.Column="6" Text="Checksum"/><TextBlock Grid.Column="7" Text="ACK"/><TextBlock Grid.Column="8" Text="Raw bytes"/></Grid>
              <ListBox Grid.Row="1" ItemsSource="{Binding VisibleCandidates}" SelectedItem="{Binding SelectedCandidate}">
                <ListBox.ItemTemplate><DataTemplate>
                  <Grid ColumnDefinitions="135,155,105,120,105,55,80,55,*" Margin="3">
                    <TextBlock Text="{Binding Time}"/><TextBlock Grid.Column="1" Text="{Binding Classification}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Source}"/><TextBlock Grid.Column="3" Text="{Binding Destination}"/>
                    <TextBlock Grid.Column="4" Text="{Binding Service}"/><TextBlock Grid.Column="5" Text="{Binding RawBytes.Length}"/>
                    <TextBlock Grid.Column="6" Text="{Binding Checksum}"/><TextBlock Grid.Column="7" Text="{Binding Ack}"/>
                    <TextBlock Grid.Column="8" Text="{Binding RawHex}" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <GridSplitter Grid.Row="2" Height="6" ResizeDirection="Rows"/>
              <ScrollViewer Grid.Row="3"><TextBlock Text="{Binding Details}" FontFamily="Consolas" TextWrapping="Wrap"/></ScrollViewer>
            </Grid>
          </TabItem>
          <TabItem Header="Events / Timeline">
            <Grid ColumnDefinitions="480,*" ColumnSpacing="8">
              <Grid RowDefinitions="Auto,Auto,*" RowSpacing="5">
                <ComboBox ItemsSource="{Binding AnalogSortOptions}" SelectedItem="{Binding SelectedAnalogSort}" HorizontalAlignment="Left" MinWidth="180"/>
                <Grid Grid.Row="1" ColumnDefinitions="45,92,95,75,55,65,55" Margin="7">
                  <TextBlock Text="Event"/><TextBlock Grid.Column="1" Text="Position"/><TextBlock Grid.Column="2" Text="Duration"/>
                  <TextBlock Grid.Column="3" Text="Samples"/><TextBlock Grid.Column="4" Text="Chunks"/>
                  <TextBlock Grid.Column="5" Text="D44 max"/><TextBlock Grid.Column="6" Text="CRC"/>
                </Grid>
                <ListBox Grid.Row="2" ItemsSource="{Binding AnalogEvents}" SelectedItem="{Binding SelectedAnalogEvent}">
                  <ListBox.ItemTemplate><DataTemplate>
                    <Grid ColumnDefinitions="45,92,95,75,55,65,55" Margin="3">
                      <TextBlock Text="{Binding EventId}"/><TextBlock Grid.Column="1" Text="{Binding PositionText}"/>
                      <TextBlock Grid.Column="2" Text="{Binding DurationText}"/><TextBlock Grid.Column="3" Text="{Binding WindowText}"/>
                      <TextBlock Grid.Column="4" Text="{Binding ChunkCountText}"/><TextBlock Grid.Column="5" Text="{Binding D44MaximumText}"/>
                      <TextBlock Grid.Column="6" Text="{Binding CrcText}"/>
                    </Grid>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </Grid>
              <Grid Grid.Column="1" ColumnDefinitions="*,340" ColumnSpacing="8">
              <Grid RowDefinitions="Auto,*,*,Auto,Auto,Auto" RowSpacing="6">
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Previous Event" Click="PreviousEventClicked"/>
                    <Button Content="Next Event" Click="NextEventClicked"/>
                    <Button Content="Fit Event" Click="ResetWaveformClicked"/>
                    <CheckBox Content="TP1 overlays" IsChecked="{Binding ShowTp1Overlays}" VerticalAlignment="Center"/>
                    <TextBlock Text="Wheel: time zoom  •  Drag: pan  •  Ctrl+wheel: Y zoom  •  Double-click: fit" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Text="{Binding EventViewerSummary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
                  <views:WaveformView x:Name="Waveform" Capture="{Binding SelectedCapture}" Decode="{Binding SelectedTp1Decode}" SelectedRecord="{Binding SelectedOfflineCandidate}" ShowTp1Overlays="{Binding ShowTp1Overlays}"/>
                </Border>
                <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1">
                  <views:WaveformView x:Name="D44Waveform" D44Mode="True" Capture="{Binding SelectedCapture}" Decode="{Binding SelectedTp1Decode}" SelectedRecord="{Binding SelectedOfflineCandidate}" ShowTp1Overlays="{Binding ShowTp1Overlays}"/>
                </Border>
                <Grid Grid.Row="3" ColumnDefinitions="65,*,80" ColumnSpacing="8">
                  <TextBlock Text="Zoom" VerticalAlignment="Center"/>
                  <Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="ZoomSliderChanged"/>
                  <ComboBox x:Name="AnalogUnit" Grid.Column="2" SelectionChanged="AnalogUnitChanged" SelectedIndex="1">
                    <ComboBoxItem Content="Estimated mV"/><ComboBoxItem Content="RAW"/>
                  </ComboBox>
                </Grid>
                <Grid Grid.Row="4" ColumnDefinitions="65,*" ColumnSpacing="8">
                  <TextBlock Text="Position" VerticalAlignment="Center"/>
                  <Slider x:Name="PositionSlider" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="PositionSliderChanged"/>
                </Grid>
                <StackPanel Grid.Row="5"><TextBlock Text="{Binding AnalogAxis}" TextWrapping="Wrap"/><TextBlock Text="{Binding AnalogCursor}" FontFamily="Consolas"/><TextBlock Text="{Binding AnalogVariationNotice}" FontWeight="Bold"/></StackPanel>
              </Grid>
              <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto,300" RowSpacing="6">
                    <TextBlock Text="TP1 RECORDS" FontWeight="Bold" FontSize="15"/>
                    <StackPanel Grid.Row="1" Spacing="5">
                      <ComboBox ItemsSource="{Binding OfflineProfiles}" SelectedItem="{Binding SelectedOfflineProfile}" MinWidth="225">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                      <ComboBox ItemsSource="{Binding OfflineRecordFilters}" SelectedItem="{Binding SelectedOfflineRecordFilter}"/>
                      <TextBlock Text="{Binding OfflineAnalysisSummary}" TextWrapping="Wrap" FontSize="11" Opacity="0.75"/>
                    </StackPanel>
                    <ListBox Grid.Row="2" ItemsSource="{Binding OfflineCandidates}" SelectedItem="{Binding SelectedOfflineCandidate}">
                      <ListBox.ItemTemplate><DataTemplate>
                        <Grid ColumnDefinitions="82,135,*" Margin="3">
                          <TextBlock Text="{Binding StartMilliseconds, StringFormat={}{0:F3} ms}"/>
                          <TextBlock Grid.Column="1" Text="{Binding RecordClassification}"/>
                          <TextBlock Grid.Column="2" Text="{Binding RawHex}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                      </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                      <Button Content="Previous Record" Click="PreviousRecordClicked"/>
                      <Button Content="Next Record" Click="NextRecordClicked"/>
                      <Button Content="Fit Event" Click="ResetWaveformClicked"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="6">
                    <Border BorderBrush="DodgerBlue" BorderThickness="1" Padding="8">
                      <StackPanel Spacing="5">
                        <TextBlock Text="{Binding OfflineFrameTitle}" FontWeight="Bold" Foreground="DodgerBlue" TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="105,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="3">
                          <TextBlock Text="Source"/><TextBlock Grid.Column="1" Text="{Binding OfflineFrameSource}" FontWeight="SemiBold"/>
                          <TextBlock Grid.Row="1" Text="Destination"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OfflineFrameDestination}" FontWeight="SemiBold"/>
                          <TextBlock Grid.Row="2" Text="Service"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OfflineFrameService}" FontWeight="SemiBold"/>
                          <TextBlock Grid.Row="3" Text="Parity"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OfflineFrameParity}" FontWeight="SemiBold"/>
                          <TextBlock Grid.Row="4" Text="Checksum"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OfflineFrameChecksum}" FontWeight="SemiBold"/>
                          <TextBlock Grid.Row="5" Text="Timing"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding OfflineFrameTiming}" FontWeight="SemiBold"/>
                          <TextBlock Grid.Row="6" Text="Octets RAW"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding OfflineFrameRaw}" FontFamily="Consolas" TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock Text="Décodée offline directement depuis les échantillons ADC." FontStyle="Italic" Opacity="0.75" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                    <TextBlock Text="CHARACTER / SLOT DIAGNOSTIC" FontWeight="Bold"/>
                    <ComboBox ItemsSource="{Binding OfflineCharacters}" SelectedItem="{Binding SelectedOfflineCharacter}">
                      <ComboBox.ItemTemplate><DataTemplate>
                        <Grid ColumnDefinitions="75,55,*">
                          <TextBlock Text="{Binding Index, StringFormat={}Character {0}}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat={}0x{0:X2}}" FontFamily="Consolas"/>
                          <TextBlock Grid.Column="2" Text="{Binding ParityValid, StringFormat={}Parity {0}}"/>
                        </Grid></DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding OfflineCharacterDiagnostic}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="48,72,62,58,58,62" Margin="0,3">
                      <TextBlock Text="Slot" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="Theory" FontWeight="Bold"/>
                      <TextBlock Grid.Column="2" Text="Sample" FontWeight="Bold"/><TextBlock Grid.Column="3" Text="Q err" FontWeight="Bold"/>
                      <TextBlock Grid.Column="4" Text="Pulse" FontWeight="Bold"/><TextBlock Grid.Column="5" Text="T err" FontWeight="Bold"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding OfflineCharacterSlots}">
                      <ItemsControl.ItemTemplate><DataTemplate>
                        <Grid ColumnDefinitions="48,72,62,58,58,62" Margin="0,1">
                          <TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding ExpectedSample, StringFormat={}{0:F2}}"/>
                          <TextBlock Grid.Column="2" Text="{Binding QuantizedExpectedSample}"/><TextBlock Grid.Column="3" Text="{Binding QuantizationErrorSamples, StringFormat={}{0:+0.00;-0.00;0.00}}"/>
                          <TextBlock Grid.Column="4" Text="{Binding AssociatedPulseSample, TargetNullValue=—}"/><TextBlock Grid.Column="5" Text="{Binding TimingErrorSamples, StringFormat={}{0:+0.00;-0.00;0.00}, TargetNullValue=—}"/>
                        </Grid></DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding OfflineProfileComparison}" TextWrapping="Wrap" FontSize="10" Opacity="0.8"/>
                    </StackPanel>
                    </ScrollViewer>
              </Grid>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem Header="Participants">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
              <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8" Margin="6">
                <Border BorderBrush="Gray" BorderThickness="0,0,1,0"><StackPanel><TextBlock Text="Trafic observé" Opacity="0.7"/><TextBlock Text="{Binding ObservedTrafficCount, StringFormat={}{0} télégrammes}" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="0,0,1,0"><StackPanel><TextBlock Text="Participants" Opacity="0.7"/><TextBlock Text="{Binding ParticipantCount}" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="0,0,1,0"><StackPanel><TextBlock Text="Groupes" Opacity="0.7"/><TextBlock Text="{Binding GroupCount}" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border>
                <StackPanel Grid.Column="3"><TextBlock Text="Motifs récurrents" Opacity="0.7"/><TextBlock Text="{Binding InteractionCount}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding SyntheticExcludedCount, StringFormat={}{0} télégrammes de test synthétiques exclus}" FontSize="11" Opacity="0.6"/></StackPanel>
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="3*,2*" ColumnSpacing="12">
                <Grid RowDefinitions="Auto,*">
                  <Grid ColumnDefinitions="110,105,90,90,80" Margin="7,5">
                    <TextBlock Text="Adresse" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="Télégrammes" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="% trafic" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="Sessions" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="Groupes" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                  </Grid>
                  <ListBox Grid.Row="1" ItemsSource="{Binding Participants}" SelectedItem="{Binding SelectedParticipant}">
                    <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="110,105,90,90,80" Margin="5,4">
                      <TextBlock Text="{Binding Address}" FontWeight="SemiBold"/>
                      <TextBlock Grid.Column="1" Text="{Binding TelegramCount}" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="2" Text="{Binding TrafficPercent, StringFormat={}{0:F1} %}" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="3" Text="{Binding SessionCount}" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="4" Text="{Binding GroupCount}" HorizontalAlignment="Right"/>
                    </Grid></DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
                <ScrollViewer Grid.Column="1"><StackPanel Spacing="10" Margin="4">
                  <TextBlock Text="{Binding SelectedParticipant.Address, StringFormat={}PARTICIPANT {0}}" FontSize="19" FontWeight="Bold"/>
                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <StackPanel><TextBlock Text="Télégrammes observés" Opacity="0.7"/><TextBlock Text="{Binding SelectedParticipant.TelegramCount}" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Part du trafic" Opacity="0.7"/><TextBlock Text="{Binding SelectedParticipant.TrafficPercent, StringFormat={}{0:F1} %}" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Sessions" Opacity="0.7"/><TextBlock Text="{Binding SelectedParticipant.SessionCount}" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="Groupes utilisés" Opacity="0.7"/><TextBlock Text="{Binding SelectedParticipant.GroupCount}" FontWeight="SemiBold"/></StackPanel>
                  </Grid>
                  <Separator/>
                  <TextBlock Text="DESTINATIONS OBSERVÉES" FontWeight="Bold"/>
                  <Grid ColumnDefinitions="110,90,130,*"><TextBlock Text="Destination" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Télégrammes" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Service" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Valeur / APDU" FontWeight="SemiBold"/></Grid>
                  <ItemsControl ItemsSource="{Binding ParticipantDestinations}"><ItemsControl.ItemTemplate><DataTemplate>
                    <Grid ColumnDefinitions="110,90,130,*" Margin="0,3"><TextBlock Text="{Binding Destination}"/><TextBlock Grid.Column="1" Text="{Binding TelegramCount}"/><TextBlock Grid.Column="2" Text="{Binding Services}" TextWrapping="Wrap"/><TextBlock Grid.Column="3" Text="{Binding ValuesAndApdu}" FontFamily="Consolas" TextWrapping="Wrap"/></Grid>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  <Separator/><TextBlock Text="PRIORITÉ · REPEAT · CHECKSUM" FontWeight="Bold"/><TextBlock Text="{Binding ParticipantPriorities}" TextWrapping="Wrap"/>
                  <TextBlock Text="MOTIFS TEMPORELS ASSOCIÉS" FontWeight="Bold"/><TextBlock Text="{Binding ParticipantMotifs}" TextWrapping="Wrap"/>
                </StackPanel></ScrollViewer>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem Header="Groupes">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
              <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8" Margin="6">
                <Border BorderBrush="Gray" BorderThickness="0,0,1,0"><StackPanel><TextBlock Text="Trafic observé" Opacity="0.7"/><TextBlock Text="{Binding ObservedTrafficCount, StringFormat={}{0} télégrammes}" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="0,0,1,0"><StackPanel><TextBlock Text="Participants" Opacity="0.7"/><TextBlock Text="{Binding ParticipantCount}" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="0,0,1,0"><StackPanel><TextBlock Text="Groupes" Opacity="0.7"/><TextBlock Text="{Binding GroupCount}" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border>
                <StackPanel Grid.Column="3"><TextBlock Text="Motifs récurrents" Opacity="0.7"/><TextBlock Text="{Binding InteractionCount}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding SyntheticExcludedCount, StringFormat={}{0} télégrammes de test synthétiques exclus}" FontSize="11" Opacity="0.6"/></StackPanel>
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="3*,2*" ColumnSpacing="12">
                <Grid RowDefinitions="Auto,*">
                  <Grid ColumnDefinitions="130,110,100,100" Margin="7,5"><TextBlock Text="Adresse groupe" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Télégrammes" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="Émetteurs" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Grid.Column="3" Text="Sessions" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                  <ListBox Grid.Row="1" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"><ListBox.ItemTemplate><DataTemplate>
                    <Grid ColumnDefinitions="130,110,100,100" Margin="5,4"><TextBlock Text="{Binding Address}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding TelegramCount}" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="{Binding EmitterCount}" HorizontalAlignment="Right"/><TextBlock Grid.Column="3" Text="{Binding SessionCount}" HorizontalAlignment="Right"/></Grid>
                  </DataTemplate></ListBox.ItemTemplate></ListBox>
                </Grid>
                <ScrollViewer Grid.Column="1"><StackPanel Spacing="10" Margin="4">
                  <TextBlock Text="{Binding SelectedGroup.Address, StringFormat={}GROUPE {0}}" FontSize="19" FontWeight="Bold"/>
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8"><StackPanel><TextBlock Text="Télégrammes" Opacity="0.7"/><TextBlock Text="{Binding SelectedGroup.TelegramCount}" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Émetteurs observés" Opacity="0.7"/><TextBlock Text="{Binding SelectedGroup.EmitterCount}" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Sessions" Opacity="0.7"/><TextBlock Text="{Binding SelectedGroup.SessionCount}" FontWeight="SemiBold"/></StackPanel></Grid>
                  <Separator/><TextBlock Text="ÉMETTEURS OBSERVÉS" FontWeight="Bold"/><ItemsControl ItemsSource="{Binding SelectedGroup.Model.Sources}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="120,*" Margin="0,3"><TextBlock Text="{Binding Value}"/><TextBlock Grid.Column="1" Text="{Binding Count, StringFormat={}{0} télégrammes}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  <TextBlock Text="SERVICES / APCI" FontWeight="Bold"/><TextBlock Text="{Binding GroupServices}" TextWrapping="Wrap"/>
                  <TextBlock Text="APDU / PAYLOADS OBSERVÉS" FontWeight="Bold"/><TextBlock Text="{Binding GroupValues}" FontFamily="Consolas" TextWrapping="Wrap"/>
                  <TextBlock Text="MOTIFS TEMPORELS ASSOCIÉS" FontWeight="Bold"/><TextBlock Text="{Binding GroupInteractions}" TextWrapping="Wrap"/>
                  <TextBlock Text="Aucun DPT ni rôle métier n'est interprété." FontStyle="Italic" Opacity="0.65"/>
                </StackPanel></ScrollViewer>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem Header="Interactions">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
              <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8" Margin="6">
                <Border BorderBrush="Gray" BorderThickness="0,0,1,0"><StackPanel><TextBlock Text="Trafic observé" Opacity="0.7"/><TextBlock Text="{Binding ObservedTrafficCount, StringFormat={}{0} télégrammes}" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="0,0,1,0"><StackPanel><TextBlock Text="Participants" Opacity="0.7"/><TextBlock Text="{Binding ParticipantCount}" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="0,0,1,0"><StackPanel><TextBlock Text="Groupes" Opacity="0.7"/><TextBlock Text="{Binding GroupCount}" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border>
                <StackPanel Grid.Column="3"><TextBlock Text="Motifs récurrents" Opacity="0.7"/><TextBlock Text="{Binding InteractionCount}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding SyntheticExcludedCount, StringFormat={}{0} télégrammes de test synthétiques exclus}" FontSize="11" Opacity="0.6"/></StackPanel>
              </Grid>
              <ComboBox Grid.Row="1" ItemsSource="{Binding InteractionSortOptions}" SelectedItem="{Binding SelectedInteractionSort}" HorizontalAlignment="Left" MinWidth="180"/>
              <Grid Grid.Row="2" ColumnDefinitions="3*,2*" ColumnSpacing="12">
                <Grid RowDefinitions="Auto,*">
                  <Grid ColumnDefinitions="*,95,80,110" Margin="7,5"><TextBlock Text="Séquence observée" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Occurrences" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="Sessions" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Grid.Column="3" Text="Délai médian" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                  <ListBox Grid.Row="1" ItemsSource="{Binding Interactions}" SelectedItem="{Binding SelectedInteraction}"><ListBox.ItemTemplate><DataTemplate>
                    <Grid ColumnDefinitions="*,95,80,110" Margin="5,5"><TextBlock Text="{Binding Sequence}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Occurrences}" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="{Binding SessionCount}" HorizontalAlignment="Right"/><TextBlock Grid.Column="3" Text="{Binding MedianDelayMs, StringFormat={}{0:F3} ms}" HorizontalAlignment="Right"/></Grid>
                  </DataTemplate></ListBox.ItemTemplate></ListBox>
                </Grid>
                <ScrollViewer Grid.Column="1"><StackPanel Spacing="9" Margin="4">
                  <TextBlock Text="MOTIF TEMPOREL RÉCURRENT" FontSize="18" FontWeight="Bold"/>
                  <TextBlock Text="SÉQUENCE A" FontWeight="Bold"/><Grid ColumnDefinitions="105,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="3"><TextBlock Text="Source"/><TextBlock Grid.Column="1" Text="{Binding SelectedInteraction.ASource}" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="Destination"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedInteraction.ADestination}" FontWeight="SemiBold"/><TextBlock Grid.Row="2" Text="Service"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedInteraction.AService}"/><TextBlock Grid.Row="3" Text="Valeur / APDU"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedInteraction.AValue}" FontFamily="Consolas" TextWrapping="Wrap"/></Grid>
                  <Separator/><TextBlock Text="DÉLAI" FontWeight="Bold"/><Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8"><StackPanel><TextBlock Text="Minimum" Opacity="0.7"/><TextBlock Text="{Binding SelectedInteraction.MinimumDelayMs, StringFormat={}{0:F3} ms}" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Médiane" Opacity="0.7"/><TextBlock Text="{Binding SelectedInteraction.MedianDelayMs, StringFormat={}{0:F3} ms}" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Moyenne" Opacity="0.7"/><TextBlock Text="{Binding SelectedInteraction.MeanDelayMs, StringFormat={}{0:F3} ms}" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Maximum" Opacity="0.7"/><TextBlock Text="{Binding SelectedInteraction.MaximumDelayMs, StringFormat={}{0:F3} ms}" FontWeight="SemiBold"/></StackPanel></Grid>
                  <Separator/><TextBlock Text="SÉQUENCE B" FontWeight="Bold"/><Grid ColumnDefinitions="105,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="3"><TextBlock Text="Source"/><TextBlock Grid.Column="1" Text="{Binding SelectedInteraction.BSource}" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="Destination"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedInteraction.BDestination}" FontWeight="SemiBold"/><TextBlock Grid.Row="2" Text="Service"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedInteraction.BService}"/><TextBlock Grid.Row="3" Text="Valeur / APDU"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedInteraction.BValue}" FontFamily="Consolas" TextWrapping="Wrap"/></Grid>
                  <Separator/><TextBlock Text="OBSERVATIONS" FontWeight="Bold"/><TextBlock Text="{Binding SelectedInteraction.Occurrences, StringFormat={}Occurrences : {0}}"/><TextBlock Text="{Binding SelectedInteraction.SessionCount, StringFormat={}Sessions distinctes : {0}}"/>
                  <TextBlock Text="Proximité temporelle observée — aucune relation causale n'est déduite." FontStyle="Italic" Opacity="0.65" TextWrapping="Wrap"/>
                </StackPanel></ScrollViewer>
              </Grid>
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>
    <TextBlock Grid.Row="4" Text="Read only • TP1 timestamps are device uptime when date_time is null • VALID_UNKNOWN is a valid frame" Opacity="0.7"/>
  </Grid>
</Window>
