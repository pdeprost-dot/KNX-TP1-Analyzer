void writeResults(uint64_t duration,uint32_t crcFails){File f=SD.open(dirPath+"/events.jsonl",FILE_WRITE);uint64_t metaBytes=0,totalEventSamples=0,minDur=UINT64_MAX,maxDur=0;for(int i=0;i<nextEvent;i++){Event&e=events[i];uint64_t dur=e.end-e.start;totalEventSamples+=dur;if(dur<minDur)minDur=dur;if(dur>maxDur)maxDur=dur;char line[700];int n=snprintf(line,sizeof(line),"{\"event_id\":%llu,\"sample_start\":%llu,\"sample_trigger\":%llu,\"sample_last_excursion\":%llu,\"sample_end\":%llu,\"pre_samples\":%llu,\"post_samples\":%llu,\"total_samples\":%llu,\"D44_trigger\":%u,\"ADC_trigger\":%u,\"D44_max\":%u,\"excursions\":%u,\"ADC_min\":%u,\"ADC_max\":%u,\"raw_bytes\":%llu,\"crc32\":\"%08X\",\"data_loss\":%llu}\n",e.id,e.start,e.trigger,e.lastExc,e.end,e.pre,e.post,dur,e.triggerD44,e.triggerAdc,e.maxD44,e.excursions,e.adcMin,e.adcMax,e.rawBytes,e.crc,e.lost);if(f)n=f.write((uint8_t*)line,n);metaBytes+=n;Serial.write((uint8_t*)line,n);}if(f){f.flush();f.close();}File af=SD.open(dirPath+"/actions.jsonl",FILE_WRITE);if(af){for(uint8_t i=0;i<10;i++){if(!actions[i].markSample)continue;char a[240];int an=snprintf(a,sizeof(a),"{\"action_id\":%u,\"mark_sample\":%llu,\"mark_us\":%llu,\"done_sample\":%llu,\"done_us\":%llu}\n",i+1,actions[i].markSample,actions[i].markUs,actions[i].doneSample,actions[i].doneUs);af.write((uint8_t*)a,an);metaBytes+=an;Serial.write((uint8_t*)a,an);}af.flush();af.close();}bool invariant=acquired==rawStored+ignored+lost;double rawPct=acquired?100.0*rawStored.load()/acquired.load():0;bool pass=nextAction==10&&lost==0&&dmaOverflow==0&&bufferOverflow==0&&sdErrors==0&&shortWrites==0&&zeroWrites==0&&crcFails==0&&invariant;File se=SD.open(dirPath+"/session-end.json",FILE_WRITE);char out[1200];int n=snprintf(out,sizeof(out),"{\"status\":\"%s\",\"duration_us\":%llu,\"adc_hz\":%.3f,\"acquired\":%llu,\"raw_stored\":%llu,\"ignored\":%llu,\"lost\":%llu,\"dma_overflow\":%u,\"buffer_overflow\":%u,\"sd_errors\":%u,\"short_writes\":%u,\"zero_writes\":%u,\"crc_failures\":%u,\