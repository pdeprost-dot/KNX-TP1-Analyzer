constexpr uint32_t SAMPLE_RATE=83333,SD_HZ=4000000;
constexpr uint64_t TEST_US=60000000ULL,FIRST_TRIGGER_US=200000ULL,TRIGGER_STEP_US=60000000ULL;
constexpr uint32_t PRE_SAMPLES=8333,EVENT_SAMPLES=4966647,POST_SAMPLES=8333,EVENT_COUNT=1;
constexpr uint32_t HIST_BINS=98,TOP_N=16;
constexpr size_t BUFFER_BYTES=16*1024,SAMPLES_PER_BUFFER=BUFFER_BYTES/2,BUFFER_COUNT=2,DMA_BYTES=1024,DMA_POOL_BYTES=49152;
struct Event{uint64_t id=0,start=0,trigger=0,activityEnd=0,end=0,pre=0,activity=0,post=0,rawStored=0,rawBytes=0,lost=0,writes=0,writeUs=0,rawOffset=UINT64_MAX;uint32_t crc=0,writeMaxUs=0,shortWrites=0,zeroWrites=0,sdErrors=0,discontinuities=0,duplicates=0;};
struct Buffer{uint32_t count=0;uint8_t event=0;uint64_t firstIndex=0;uint16_t samples[SAMPLES_PER_BUFFER];};
Event events[EVENT_COUNT];Buffer*buffers[BUFFER_COUNT]{};uint16_t*preRing=nullptr;uint32_t ringHead=0,ringCount=0;
struct DetectorStats{uint64_t count=0,sum=0,hist[HIST_BINS]{};uint32_t min=UINT32_MAX,max=0;};
struct Excursion{uint64_t sample=0;uint32_t d2=0,d4=0,d8=0,d44=0;};
DetectorStats detectors[4];Excursion top[4][TOP_N]{};uint32_t topFloor[4]{};uint16_t history[8]{};uint8_t historyPos=0,historyCount=0;uint64_t detectorMetadataBytes=0;
QueueHandle_t freeQ=nullptr,readyQ=nullptr;adc_continuous_handle_t adc=nullptr;File raw;String dirPath;
std::atomic<bool> active{false},adcDrained{true},stopping{false},windowDone{false};
std::atomic<uint64_t> acquired{0},rawStored{0},ignored{0},lost{0},rawBytes{0};
std::atomic<uint32_t> dmaOverflow{0},bufferOverflow{0},sdErrors{0},shortWrites{0},zeroWrites{0};volatile uint32_t dmaOverflowIsr=0;
uint64_t startedUs=0,silenceCount=0,silenceSum=0;uint16_t silenceMin=UINT16_MAX,silenceMax=0;int currentEvent=-1,nextEvent=0;Buffer*cur=nullptr;uint64_t lastQueuedIndex=UINT64_MAX;

bool IRAM_ATTR onOverflow(adc_continuous_handle_t,const adc_continuous_evt_data_t*,void*){++dmaOverflowIsr;return false;}
bool initAdc(){adc_continuous_handle_cfg_t h{};h.max_store_buf_size=DMA_POOL_BYTES;h.conv_frame_size=DMA_BYTES;if(adc_continuous_new_handle(&h,&adc)!=ESP_OK)return false;adc_digi_pattern_config_t p{};p.atten=ADC_ATTEN_DB_12;p.channel=ADC_CHANNEL_5;p.unit=ADC_UNIT_1;p.bit_width=SOC_ADC_DIGI_MAX_BITWIDTH;adc_continuous_config_t c{};c.pattern_num=1;c.adc_pattern=&p;c.sample_freq_hz=SAMPLE_RATE;c.conv_mode=ADC_CONV_SINGLE_UNIT_1;c.format=ADC_DIGI_OUTPUT_FORMAT_TYPE2;if(adc_continuous_config(adc,&c)!=ESP_OK)return false;adc_continuous_evt_cbs_t cb{};cb.on_pool_ovf=onOverflow;return adc_continuous_register_event_callbacks(adc,&cb,nullptr)==ESP_OK;}
void queuePartial(){if(cur&&cur->count){xQueueSend(readyQ,&cur,portMAX_DELAY);cur=nullptr;}}
void ignoreSample(uint16_t v){++ignored;++silenceCount;silenceSum+=v;if(v<silenceMin)silenceMin=v;if(v>silenceMax)silenceMax=v;}
void ringPush(uint16_t v){if(ringCount==PRE_SAMPLES){ignoreSample(preRing[ringHead]);}else ++ringCount;preRing[ringHead]=v;if(++ringHead==PRE_SAMPLES)ringHead=0;}
uint32_t histogramBin(uint32_t v){if(v<64)return v;if(v<128)return 64+(v-64)/4;if(v<256)return 80+(v-128)/16;if(v<512)return 88+(v-256)/64;if(v<1024)return 92+(v-512)/256;if(v<2048)return 94;if(v<4096)return 95;if(v<8192)return 96;return 97;}
void updateTop(uint8_t detector,uint32_t value,const Excursion&e){if(value<=topFloor[detector])return;uint8_t slot=0;uint32_t minimum=UINT32_MAX;for(uint8_t i=0;i<TOP_N;i++){uint32_t x=detector==0?top[detector][i].d2:detector==1?top[detector][i].d4:detector==2?top[detector][i].d8:top[detector][i].d44;if(x<minimum){minimum=x;slot=i;}}top[detector][slot]=e;minimum=UINT32_MAX;for(uint8_t i=0;i<TOP_N;i++){uint32_t x=detector==0?top[detector][i].d2:detector==1?top[detector][i].d4:detector==2?top[detector][i].d8:top[detector][i].d44;if(x<minimum)minimum=x;}topFloor[detector]=minimum;}
void measureDetectors(uint16_t v,uint64_t index){if(historyCount<8){history[historyPos]=v;historyPos=(historyPos+1)&7;++historyCount;return;}uint16_t x1=history[(historyPos+7)&7],x2=history[(historyPos+6)&7],x3=history[(historyPos+5)&7],x4=history[(historyPos+4)&7],x5=history[(historyPos+3)&7],x6=history[(historyPos+2)&7],x7=history[(historyPos+1)&7];uint32_t values[4]={uint32_t(abs(int32_t(v)-int32_t(x2))),uint32_t(abs(int32_t(v)-int32_t(x4))),uint32_t(abs(int32_t(v)-int32_t(history[historyPos]))),uint32_t(abs(int32_t(uint32_t(v)+x1+x2+x3)-int32_t(uint32_t(x4)+x5+x6+x7)))};Excursion e{index,values[0],values[1],values[2],values[3]};for(uint8_t i=0;i<4;i++){DetectorStats&d=detectors[i];uint32_t value=values[i];++d.count;d.sum+=value;if(value<d.min)d.min=value;if(value>d.max)d.max=value;++d.hist[histogramBin(value)];updateTop(i,value,e);}history[historyPos]=v;historyPos=(historyPos+1)&7;}
void appendRaw(uint16_t v,uint64_t index,int eid){Event&e=events[eid];if(lastQueuedIndex!=UINT64_MAX){if(index==lastQueuedIndex)e.duplicates++;else if(index!=lastQueuedIndex+1)e.discontinuities++;}if(!cur&&xQueueReceive(freeQ,&cur,0)!=pdTRUE){++lost;++e.lost;++bufferOverflow;return;}if(cur->count==0){cur->event=eid;cur->firstIndex=index;}cur->samples[cur->count++]=v;lastQueuedIndex=index;if(cur->count==SAMPLES_PER_BUFFER){xQueueSend(readyQ,&cur,portMAX_DELAY);cur=nullptr;}}
void beginEvent(uint64_t trigger){Event&e=events[nextEvent];e.id=nextEvent+1;e.trigger=trigger;e.pre=ringCount;e.start=trigger-ringCount;e.activity=EVENT_SAMPLES;e.post=POST_SAMPLES;e.activityEnd=trigger+EVENT_SAMPLES;e.end=e.activityEnd+POST_SAMPLES;lastQueuedIndex=UINT64_MAX;uint32_t pos=(ringHead+PRE_SAMPLES-ringCount)%PRE_SAMPLES;for(uint32_t i=0;i<ringCount;i++){appendRaw(preRing[pos],e.start+i,nextEvent);if(++pos==PRE_SAMPLES)pos=0;}ringCount=0;currentEvent=nextEvent++;}
void endEvent(){queuePartial();currentEvent=-1;lastQueuedIndex=UINT64_MAX;}

void adcTask(void*){alignas(4)uint8_t dma[DMA_BYTES];while(true){if(!active){queuePartial();adcDrained=true;vTaskDelay(pdMS_TO_TICKS(2));continue;}uint32_t bytes=0;esp_err_t er=adc_continuous_read(adc,dma,sizeof(dma),&bytes,50);dmaOverflow=dmaOverflowIsr;if(er==ESP_ERR_TIMEOUT)continue;if(er!=ESP_OK)continue;uint64_t now=esp_timer_get_time(),elapsed=now-startedUs;if(elapsed>=TEST_US){windowDone=true;continue;}if(currentEvent<0&&nextEvent<EVENT_COUNT&&elapsed>=FIRST_TRIGGER_US+uint64_t(nextEvent)*TRIGGER_STEP_US)beginEvent(acquired.load());for(uint32_t off=0;off+SOC_ADC_DIGI_RESULT_BYTES<=bytes;off+=SOC_ADC_DIGI_RESULT_BYTES){const auto*r=(const adc_digi_output_data_t*)(dma+off);if(r->type2.channel!=ADC_CHANNEL_5)continue;uint16_t v=r->type2.data;uint64_t idx=acquired.fetch_add(1);measureDetectors(v,idx);if(currentEvent>=0){Event&e=events[currentEvent];if(idx<e.end){appendRaw(v,idx,currentEvent);continue;}endEvent();}ringPush(v);}}}

void writerTask(void*){while(true){Buffer*b=nullptr;if(xQueueReceive(readyQ,&b,pdMS_TO_TICKS(20))==pdTRUE){Event&e=events[b->event];size_t req=b->count*2;if(e.rawOffset==UINT64_MAX)e.rawOffset=raw.position();uint64_t wb=esp_timer_get_time();size_t n=raw?raw.write((uint8_t*)b->samples,req):0;uint32_t dt=uint32_t(esp_timer_get_time()-wb);++e.writes;e.writeUs+=dt;if(dt>e.writeMaxUs)e.writeMaxUs=dt;size_t ns=n/2;e.rawStored+=ns;e.rawBytes+=n;e.crc=esp_crc32_le(e.crc,(uint8_t*)b->samples,n);rawStored+=ns;rawBytes+=n;if(n!=req){++shortWrites;++sdErrors;++e.shortWrites;++e.sdErrors;if(n==0){++zeroWrites;++e.zeroWrites;}uint64_t missing=b->count-ns;lost+=missing;e.lost+=missing;Serial.printf("{\"type\":\"SD_ERROR\",\"event\":%llu,\"requested\":%u,\"actual\":%u}\n",e.id,unsigned(req),unsigned(n));}b->count=0;xQueueSend(freeQ,&b,portMAX_DELAY);}if(stopping&&uxQueueMessagesWaiting(readyQ)==0){if(raw)raw.flush();stopping=false;}}}

uint32_t verifyCrc(){File f=SD.open(dirPath+"/raw.bin",FILE_READ);if(!f)return EVENT_COUNT;uint8_t buf[4096];uint32_t fails=0;for(auto&e:events){uint32_t crc=0;uint64_t left=e.rawBytes;if(!f.seek(e.rawOffset)){++fails;continue;}while(left){size_t want=left>sizeof(buf)?sizeof(buf):left;size_t n=f.read(buf,want);if(n!=want){++fails;break;}crc=esp_crc32_le(crc,buf,n);left-=n;}if(left==0&&crc!=e.crc)++fails;}f.close();return fails;}
uint64_t writeDetectorMetadata(){const char*names[4]={"D2","D4","D8","D44"};uint64_t bytes=0;File f=SD.open(dirPath+"/detector-stats.jsonl",FILE_WRITE);if(f){f.println("{\"histogram_mapping\":\"bins 0..63 exact; 64..127 step 4; 128..255 step 16; 256..511 step 64; 512..1023 step 256; 1024..2047; 2048..4095; 4096..8191; 8192..16383\"}");for(uint8_t d=0;d<4;d++){DetectorStats&x=detectors[d];f.printf("{\"detector\":\"%s\",\"count\":%llu,\"min\":%u,\"max\":%u,\"mean\":%.6f,\"hist\":[",names[d],x.count,x.min==UINT32_MAX?0:x.min,x.max,x.count?double(x.sum)/x.count:0);for(uint32_t i=0;i<HIST_BINS;i++){if(i)f.print(',');f.print(x.hist[i]);}f.println("]}");}bytes=f.position();f.flush();f.close();}File e=SD.open(dirPath+"/excursions.jsonl",FILE_WRITE);if(e){for(uint8_t d=0;d<4;d++)for(uint8_t i=0;i<TOP_N;i++){Excursion&x=top[d][i];if(x.sample)e.printf("{\"rank_source\":\"%s\",\"sample_index\":%llu,\"D2\":%u,\"D4\":%u,\"D8\":%u,\"D44\":%u}\n",names[d],x.sample,x.d2,x.d4,x.d8,x.d44);}bytes+=e.position();e.flush();e.close();}return bytes;}
void printDetectorResults(){const char*names[4]={"D2","D4","D8","D44"};for(uint8_t d=0;d<4;d++){DetectorStats&x=detectors[d];Serial.printf("{\"type\":\"DETECTOR\",\"name\":\"%s\",\"count\":%llu,\"min\":%u,\"max\":%u,\"mean\":%.6f,\"hist\":[",names[d],x.count,x.min==UINT32_MAX?0:x.min,x.max,x.count?double(x.sum)/x.count:0);for(uint32_t i=0;i<HIST_BINS;i++){if(i)Serial.print(',');Serial.print(x.hist[i]);}Serial.println("]}");for(uint8_t i=0;i<TOP_N;i++){Excursion&e=top[d][i];if(e.sample)Serial.printf("{\"type\":\"EXCURSION\",\"source\":\"%s\",\"sample\":%llu,\"D2\":%u,\"D4\":%u,\"D8\":%u,\"D44\":%u}\n",names[d],e.sample,e.d2,e.d4,e.d8,e.d44);}}}
void writeMetadata(uint64_t duration,uint32_t crcFails){File f=SD.open(dirPath+"/events.jsonl",FILE_WRITE);uint64_t metaBytes=detectorMetadataBytes,preSum=0,postSum=0,eventSum=0;uint32_t preMin=UINT32_MAX,preMax=0,postMin=UINT32_MAX,postMax=0,disc=0,dups=0;for(auto&e:events){preSum+=e.pre;postSum+=e.post;eventSum+=e.activity;if(e.pre<preMin)preMin=e.pre;if(e.pre>preMax)preMax=e.pre;if(e.post<postMin)postMin=e.post;if(e.post>postMax)postMax=e.post;disc+=e.discontinuities;dups+=e.duplicates;char line[600];int n=snprintf(line,sizeof(line),"{\"event_id\":%llu,\"trigger_type\":\"ARTIFICIAL_TIMER\",\"sample_start\":%llu,\"sample_trigger\":%llu,\"sample_activity_end\":%llu,\"sample_end\":%llu,\"pre_samples\":%llu,\"activity_samples\":%llu,\"post_samples\":%llu,\"total_raw_samples\":%llu,\"raw_offset\":%llu,\"raw_bytes\":%llu,\"crc32\":\"%08X\",\"data_loss\":%llu,\"discontinuities\":%u,\"duplicates\":%u}\n",e.id,e.start,e.trigger,e.activityEnd,e.end,e.pre,e.activity,e.post,e.rawStored,e.rawOffset,e.rawBytes,e.crc,e.lost,e.discontinuities,e.duplicates);if(f)n=f.write((uint8_t*)line,n);metaBytes+=n;}if(f){f.flush();f.close();}bool invariant=acquired==rawStored+ignored+lost;File se=SD.open(dirPath+"/session-end.json",FILE_WRITE);char end[900];int n=snprintf(end,sizeof(end),"{\"status\":\"%s\",\"duration_us\":%llu,\"adc_hz\":%.3f,\"acquired\":%llu,\"raw_stored\":%llu,\"ignored\":%llu,\"lost\":%llu,\"dma_overflow\":%u,\"buffer_overflow\":%u,\"sd_errors\":%u,\"short_writes\":%u,\"zero_writes\":%u,\"events\":%u,\"pre_avg\":%.3f,\"pre_min\":%u,\"pre_max\":%u,\"activity_avg\":%.3f,\"post_avg\":%.3f,\"post_min\":%u,\"post_max\":%u,\"discontinuities\":%u,\"duplicates\":%u,\"crc_failures\":%u,\"raw_bytes\":%llu,\"invariant\":%s}\n",invariant&&lost==0&&dmaOverflow==0&&sdErrors==0&&disc==0&&dups==0&&crcFails==0?"CLOSED":"FAILED",duration,double(acquired.load())*1000000.0/duration,acquired.load(),rawStored.load(),ignored.load(),lost.load(),dmaOverflow.load(),bufferOverflow.load(),sdErrors.load(),shortWrites.load(),zeroWrites.load(),nextEvent,double(preSum)/EVENT_COUNT,preMin,preMax,double(eventSum)/EVENT_COUNT,double(postSum)/EVENT_COUNT,postMin,postMax,disc,dups,crcFails,rawBytes.load(),invariant?"true":"false");if(se){se.write((uint8_t*)end,n);se.flush();se.close();}metaBytes+=n;uint64_t total=rawBytes+metaBytes;bool pass=invariant&&duration>=TEST_US&&nextEvent==EVENT_COUNT&&lost==0&&dmaOverflow==0&&bufferOverflow==0&&sdErrors==0&&disc==0&&dups==0&&crcFails==0;Serial.printf("{\"type\":\"RESULT\",\"pass\":%s,\"duration_us\":%llu,\"adc_hz\":%.3f,\"acquired\":%llu,\"raw_stored\":%llu,\"ignored\":%llu,\"lost\":%llu,\"dma_overflow\":%u,\"buffer_overflow\":%u,\"sd_errors\":%u,\"short_writes\":%u,\"zero_writes\":%u,\"events\":%u,\"discontinuities\":%u,\"duplicates\":%u,\"crc_failures\":%u,\"raw_bytes\":%llu,\"session_bytes\":%llu,\"invariant\":%s}\n",pass?"true":"false",duration,double(acquired.load())*1000000.0/duration,acquired.load(),rawStored.load(),ignored.load(),lost.load(),dmaOverflow.load(),bufferOverflow.load(),sdErrors.load(),shortWrites.load(),zeroWrites.load(),nextEvent,disc,dups,crcFails,rawBytes.load(),total,invariant?"true":"false");}

void finish(){if(!active&&!stopping)return;active=false;adc_continuous_stop(adc);uint32_t d=millis()+1000;while(!adcDrained&&int32_t(d-millis())>0)delay(1);if(currentEvent>=0)endEvent();for(uint32_t i=0;i<ringCount;i++)++ignored;ringCount=0;stopping=true;d=millis()+5000;while(stopping&&int32_t(d-millis())>0)delay(2);if(raw){raw.flush();raw.close();}uint64_t duration=esp_timer_get_time()-startedUs;uint32_t crcFails=verifyCrc();detectorMetadataBytes=writeDetectorMetadata();printDetectorResults();writeMetadata(duration,crcFails);}
void start(){char d[32];snprintf(d,sizeof(d),"/RING-%08lX",(unsigned long)esp_random());dirPath=d;if(!SD.mkdir(dirPath)){Serial.println("{\"type\":\"MKDIR_ERROR\"}");return;}raw=SD.open(dirPath+"/raw.bin",FILE_WRITE);if(!raw){Serial.println("{\"type\":\"OPEN_ERROR\"}");return;}memset(events,0,sizeof(events));for(auto&e:events)e.rawOffset=UINT64_MAX;memset(detectors,0,sizeof(detectors));for(auto&d:detectors)d.min=UINT32_MAX;memset(top,0,sizeof(top));memset(topFloor,0,sizeof(topFloor));memset(history,0,sizeof(history));historyPos=historyCount=0;detectorMetadataBytes=0;acquired=rawStored=ignored=lost=rawBytes=0;dmaOverflow=bufferOverflow=sdErrors=shortWrites=zeroWrites=0;dmaOverflowIsr=0;ringHead=ringCount=0;currentEvent=-1;nextEvent=0;cur=nullptr;silenceCount=silenceSum=0;silenceMin=UINT16_MAX;silenceMax=0;windowDone=false;adcDrained=false;startedUs=esp_timer_get_time();if(adc_continuous_start(adc)!=ESP_OK){raw.close();Serial.println("{\"type\":\"ADC_START_ERROR\"}");return;}active=true;Serial.printf("{\"type\":\"START\",\"dir\":\"%s\"}\n",dirPath.c_str());}
void setup(){Serial.begin(115200);delay(1200);pinMode(14,OUTPUT);digitalWrite(14,HIGH);SPI.begin(1,3,2,14);bool sd=SD.begin(4,SPI,SD_HZ);freeQ=xQueueCreate(BUFFER_COUNT,sizeof(Buffer*));readyQ=xQueueCreate(BUFFER_COUNT,sizeof(Buffer*));for(size_t i=0;i<BUFFER_COUNT;i++){buffers[i]=(Buffer*)heap_caps_calloc(1,sizeof(Buffer),MALLOC_CAP_INTERNAL|MALLOC_CAP_DMA|MALLOC_CAP_8BIT);xQueueSend(freeQ,&buffers[i],portMAX_DELAY);}preRing=(uint16_t*)heap_caps_malloc(PRE_SAMPLES*2,MALLOC_CAP_INTERNAL|MALLOC_CAP_8BIT);bool a=initAdc();xTaskCreate(adcTask,"adc",4096,nullptr,4,nullptr);xTaskCreate(writerTask,"writer",4096,nullptr,2,nullptr);Serial.printf("{\"type\":\"BOOT\",\"sd\":%s,\"adc\":%s,\"ring\":%s}\n",sd?"true":"false",a?"true":"false",preRing?"true":"false");}
void loop(){if(active&&(windowDone||sdErrors))finish();if(Serial.available()){String c=Serial.readStringUntil('\n');c.trim();c.toUpperCase();if(c=="RUN")start();else if(c=="STOP")finish();}delay(1);}
